# Copy to .env for local use ONLY if you load it yourself; on Render set these in the dashboard.
# Never commit real values. .env is listed in .gitignore.

# --- Core --------------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# --- Shared database (leave unset locally to use SQLite) ---------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Email (forgot password, invitations) -----------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FoodWastePredictor <noreply@example.com>

# --- External data providers (all optional; manual entry always works) -------
# Weather: Open-Meteo needs no key (free for non-commercial use; see their terms)
OPEN_METEO_API_KEY=
# Traffic: TomTom Traffic Flow
TOMTOM_API_KEY=
# Local events: Ticketmaster Discovery (limited coverage outside US/Europe/etc.)
TICKETMASTER_API_KEY=
